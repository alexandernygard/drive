{
  "name": "@alexandernygard/drive",
  "version": "0.1.0",
  "description": "Client for Nyggis Drive: open, create and share documents from word2, xl2 and ppt2, plus the shared React pieces (share dialog, avatars, file icons).",
  "type": "module",
  "license": "MIT",
  "author": "Alexander Nygård",
  "sideEffects": false,
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./core": {
      "types": "./src/core.ts",
      "import": "./src/core.ts"
    },
    "./react": {
      "types": "./src/react/index.ts",
      "import": "./src/react/index.ts"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./core": {
        "types": "./dist/core.d.ts",
        "import": "./dist/core.js"
      },
      "./react": {
        "types": "./dist/react/index.d.ts",
        "import": "./dist/react/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "pnpm test && pnpm build"
  },
  "peerDependencies": {
    "@alexandernygard/components": ">=0.1.4",
    "lucide-react": ">=1",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "@alexandernygard/components": {
      "optional": true
    },
    "lucide-react": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@alexandernygard/components": "^0.2.0",
    "@types/react": "^19.3.0",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "typescript": "~5.9.3",
    "vitest": "^5.0.5"
  }
}
